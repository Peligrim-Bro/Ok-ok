{
  "name": "pattayaok",
  "private": true,
  "version": "71.0.0",
  "description": "PattayaOK static PWA + paid ads function",
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "sharp": "^0.34.4"
  },
  "scripts": {
    "build": "node gloss-build.mjs && node telegram-build.mjs",
    "check": "node scripts/verify-project.mjs && node scripts/verify-quality.mjs",
    "test:mobile": "playwright test",
