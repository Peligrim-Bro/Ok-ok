{
  "name": "okok-threads-auth",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "THREADS_QUEUE",
        "class_name": "ThreadsQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-threads-queue",
      "new_sqlite_classes": [
        "ThreadsQueue"
      ]
    }
  ]
}
